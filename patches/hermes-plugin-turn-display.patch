@@ -0,0 +1,153 @@
+"""A plugin-injected turn shows its thoughts and hides tool chrome, streaming and notices, selectively."""
+import importlib
+import sys
+import time
+import types
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform
+from gateway.run_turn import PLUGIN_TURN_DISPLAY_DEFAULTS, plugin_turn_display
+from gateway.session import SessionSource
+
+from tests.gateway.test_run_progress_topics import FakeAgent, ProgressCaptureAdapter, _make_runner
+
+
+def _event(**meta):
+    return SimpleNamespace(metadata=meta)
+
+
+def test_only_plugin_injected_turns_get_a_policy():
+    assert plugin_turn_display(_event(), user_config={}) is None
+    assert plugin_turn_display(SimpleNamespace(metadata=None), user_config={}) is None
+    assert plugin_turn_display(_event(source="background_process"), user_config={}) is None
+
+
+def test_defaults_show_thoughts_and_hide_the_rest():
+    policy = plugin_turn_display(_event(hermes_plugin_injection=True), user_config={})
+    assert policy == PLUGIN_TURN_DISPLAY_DEFAULTS
+    assert policy["thinking"] and policy["interim"]
+    assert not (policy["tool_progress"] or policy["streaming"] or policy["notices"])
+
+
+def test_the_user_config_sets_the_policy_and_a_plugin_can_only_narrow_it():
+    cfg = {"display": {"plugin_turns": {"tool_progress": True, "interim": False}}}
+    policy = plugin_turn_display(_event(hermes_plugin_injection=True), user_config=cfg)
+    assert policy["tool_progress"] and not policy["interim"] and policy["thinking"]
+    narrowed = plugin_turn_display(_event(hermes_plugin_injection=True,
+                                          hermes_display={"thinking": False, "interim": True, "streaming": True}),
+                                   user_config=cfg)
+    assert not narrowed["thinking"]                       # hidden by the plugin for this turn
+    assert not narrowed["interim"] and not narrowed["streaming"]   # it can't show what the user's config hides
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("show_tools", [False, True])
+async def test_tool_progress_follows_the_policy(monkeypatch, tmp_path, show_tools):
+    monkeypatch.setenv("HERMES_TOOL_PROGRESS_MODE", "all")
+    fake_run_agent = types.ModuleType("run_agent")
+    fake_run_agent.AIAgent = FakeAgent
+    monkeypatch.setitem(sys.modules, "run_agent", fake_run_agent)
+    adapter = ProgressCaptureAdapter()
+    runner = _make_runner(adapter)
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: {"api_key": "***"})
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm")
+    policy = dict(PLUGIN_TURN_DISPLAY_DEFAULTS, tool_progress=show_tools)
+    result = await runner._run_agent(message="[continuity: something came to mind]", context_prompt="", history=[],
+                                     source=source, session_id="s", session_key="agent:main:telegram:dm:123",
+                                     plugin_display=policy)
+    assert result["final_response"] == "done"
+    shown = " ".join(str(m["content"]) for m in adapter.sent) + " ".join(str(e["content"]) for e in adapter.edits)
+    assert ("Running pwd" in shown) is show_tools
+
+
+def test_inject_message_carries_the_policy_to_the_gateway(monkeypatch):
+    from hermes_cli import plugins as P
+    captured = {}
+    manager = SimpleNamespace(_cli_ref=None, has_gateway_message_injector=True,
+                              inject_gateway_message=lambda **kw: captured.update(kw) or True)
+    monkeypatch.setattr(P.PluginContext, "plugin_id", property(lambda self: "continuity"))
+    monkeypatch.setattr(P.PluginContext, "_gateway_injection_allowed", lambda self: True)
+    ctx = P.PluginContext(SimpleNamespace(name="continuity"), manager)
+    assert ctx.inject_message("hi", session_key="k", display={"thinking": 0})
+    assert captured["display"] == {"thinking": False} and captured["plugin_id"] == "continuity"
+    captured.clear()
+    assert ctx.inject_message("hi", session_key="k")
+    assert "display" not in captured
+
+
+def test_a_plugin_can_label_its_turn_without_widening_anything():
+    policy = plugin_turn_display(_event(hermes_plugin_injection=True,
+                                        hermes_display={"label": " Own turn · noticed ", "thinking": True}),
+                                 user_config={"display": {"plugin_turns": {"thinking": False}}})
+    assert policy["label"] == "Own turn · noticed" and not policy["thinking"]
+    assert "label" not in plugin_turn_display(_event(hermes_plugin_injection=True, hermes_display={"label": 3}),
+                                              user_config={})
+
+
+def test_inject_message_keeps_the_label_as_text(monkeypatch):
+    from hermes_cli import plugins as P
+    captured = {}
+    manager = SimpleNamespace(_cli_ref=None, has_gateway_message_injector=True,
+                              inject_gateway_message=lambda **kw: captured.update(kw) or True)
+    monkeypatch.setattr(P.PluginContext, "plugin_id", property(lambda self: "continuity"))
+    monkeypatch.setattr(P.PluginContext, "_gateway_injection_allowed", lambda self: True)
+    ctx = P.PluginContext(SimpleNamespace(name="continuity"), manager)
+    assert ctx.inject_message("hi", session_key="k", display={"interim": 1, "label": "Own turn"})
+    assert captured["display"] == {"interim": True, "label": "Own turn"}
+
+
+class _ThinkingAloudAgent(FakeAgent):
+    def run_conversation(self, message, conversation_history=None, task_id=None, **kwargs):
+        cb = getattr(self, "interim_assistant_callback", None)
+        if cb is not None:
+            cb("This one I'll let go.")
+            time.sleep(0.35)
+        return {"final_response": "[SILENT]", "messages": [], "api_calls": 1}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("injected", [True, False])
+async def test_in_between_text_of_a_plugin_turn_reads_as_its_own_process(monkeypatch, tmp_path, injected):
+    import time as _time  # noqa: F401  (the fake agent sleeps so the consumer can flush)
+    fake_run_agent = types.ModuleType("run_agent")
+    fake_run_agent.AIAgent = _ThinkingAloudAgent
+    monkeypatch.setitem(sys.modules, "run_agent", fake_run_agent)
+    adapter = ProgressCaptureAdapter()
+    runner = _make_runner(adapter)
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: {"api_key": "***"})
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm")
+    await runner._run_agent(message="[continuity: something came to mind]", context_prompt="", history=[],
+                            source=source, session_id="s", session_key="agent:main:telegram:dm:123",
+                            plugin_display=dict(PLUGIN_TURN_DISPLAY_DEFAULTS) if injected else None)
+    shown = [str(m["content"]) for m in adapter.sent] + [str(e["content"]) for e in adapter.edits]
+    assert any("This one I'll let go." in s for s in shown)
+    assert any(s.startswith("💭 This one I'll let go.") for s in shown) is injected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("meta,expect_sent", [
+    ({"hermes_plugin_injection": True, "hermes_display": {"label": "Own turn · something came to mind"}}, True),
+    ({"hermes_plugin_injection": True, "hermes_display": {"thinking": False}}, False),
+    ({}, False),                                                     # the user's own turn: reasoning rides the reply
+])
+async def test_a_silent_plugin_turn_still_shows_its_thinking_quietly(monkeypatch, meta, expect_sent):
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_resolve_gateway_display_bool",
+                        lambda cfg, key, setting, **kw: setting == "show_reasoning")     # the user shows reasoning
+    adapter = ProgressCaptureAdapter()
+    runner = _make_runner(adapter)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm")
+    await runner._hmwa_send_plugin_turn_thoughts(SimpleNamespace(metadata=meta),
+                                                 {"last_reasoning": "It's an echo of my own line; let it go."}, source)
+    assert bool(adapter.sent) is expect_sent
+    if expect_sent:
