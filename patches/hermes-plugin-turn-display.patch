+# What a turn a plugin injected (ctx.inject_message) may show while it runs. Such a turn is proactive work: its
+# tool chrome, streaming and long-running notices would ping the user before its result is known, and the plugin
+# decides what of the final reply reaches them. Its thoughts (thinking progress, in-between assistant text) stay
+# visible by default; on platforms with quiet delivery (Telegram's default "important" mode) they arrive without a
+# notification. ``display.plugin_turns`` overrides these defaults; a plugin can narrow them per turn.
+PLUGIN_TURN_DISPLAY_DEFAULTS = {"thinking": True, "interim": True, "tool_progress": False, "streaming": False,
+                                "notices": False}
+# Its in-between text is the agent's own process, not a message to the user: marked so it reads that way.
+PLUGIN_TURN_INTERIM_PREFIX = "💭 "
+
+
+def plugin_turn_display(event: Any, user_config: Optional[Dict[str, Any]] = None) -> Optional[Dict[str, Any]]:
+    """The display policy for a plugin-injected turn, or None for any other turn."""
+    meta = getattr(event, "metadata", None) or {}
+    if not meta.get("hermes_plugin_injection"):
+        return None
+    if user_config is None:
+        try:
+            from gateway.run import _load_gateway_config
+            user_config = _load_gateway_config() or {}
+        except Exception:
+            user_config = {}
+    policy = dict(PLUGIN_TURN_DISPLAY_DEFAULTS)
+    configured = ((user_config or {}).get("display") or {}).get("plugin_turns") or {}
+    if isinstance(configured, dict):
+        policy.update({k: bool(v) for k, v in configured.items() if k in policy})
+    per_turn = meta.get("hermes_display") or {}
+    if isinstance(per_turn, dict):                   # a plugin can hide a surface, never show one the user hid
+        policy.update({k: policy[k] and bool(v) for k, v in per_turn.items() if k in PLUGIN_TURN_DISPLAY_DEFAULTS})
+        if isinstance(per_turn.get("label"), str) and per_turn["label"].strip():
+            policy["label"] = per_turn["label"].strip()[:200]
+    return policy
