From 59346955e67492656cabca5012c2283b69cbb59d Mon Sep 17 00:00:00 2001
From: Joey Payton <joey.payton@gmail.com>
Date: Sat, 3 Oct 2026 13:52:49 -0400
Subject: [PATCH] gateway: plugin-injected turns are quiet proactive work, like
 heartbeats

A turn a plugin starts with ctx.inject_message is proactive work, as a
scheduled heartbeat is: tool progress, interim assistant text, thinking,
streaming, the typing indicator and long-running notices would ping the user
before the final result is known. Heartbeats already suppress all of these;
plugin-injected turns did not, so a plugin that holds or silences a turn's
final reply (via transform_llm_output or [SILENT]) still leaked the chatter.

quiet_proactive_turn(event) now covers both. Other internal events
(background-process notices, delegation results) are unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 gateway/run_turn.py                      | 14 +++++++++++++-
 tests/gateway/test_quiet_plugin_turns.py | 15 +++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)
 create mode 100644 tests/gateway/test_quiet_plugin_turns.py

diff --git a/gateway/run_turn.py b/gateway/run_turn.py
index 9db244f..a240885 100644
--- a/gateway/run_turn.py
+++ b/gateway/run_turn.py
@@ -163,6 +163,18 @@ def hygiene_no_commit_reason(agent) -> str:
     return "in-place commit did not complete"
 
 
+
+def quiet_proactive_turn(event: Any) -> bool:
+    """Whether a turn is proactive work that must stay quiet until its result is known.
+
+    A scheduled heartbeat, and a turn a plugin injected (``ctx.inject_message``), get no tool chrome, drafts,
+    thinking, typing indicator, streaming or long-running notices: they would ping the user before the final
+    result is known, and a plugin decides what of an injected turn reaches the user (its final reply can still
+    go out, or be held). Other internal events, such as background-process notices, are unchanged."""
+    if getattr(event, "_heartbeat_session_id", None):
+        return True
+    return bool((getattr(event, "metadata", None) or {}).get("hermes_plugin_injection"))
+
 class GatewayTurnMixin:
     """Agent-turn execution for GatewayRunner (see module docstring)."""
 
@@ -2182,7 +2194,7 @@ class GatewayTurnMixin:
                 persist_user_display_metadata={
                     "gateway_input_owner": prepared.persistence_owner, **diagnostic_metadata(event)},
                 message_type=event.message_type,
-                scheduled_heartbeat=bool(getattr(event, "_heartbeat_session_id", None)),
+                scheduled_heartbeat=quiet_proactive_turn(event),
             )
             _turn_seconds = time.monotonic() - _turn_started_monotonic
 
diff --git a/tests/gateway/test_quiet_plugin_turns.py b/tests/gateway/test_quiet_plugin_turns.py
new file mode 100644
index 0000000..b7abb30
--- /dev/null
+++ b/tests/gateway/test_quiet_plugin_turns.py
@@ -0,0 +1,15 @@
+"""A plugin-injected turn is proactive work: quiet like a scheduled heartbeat until its result is known."""
+from types import SimpleNamespace
+
+from gateway.run_turn import quiet_proactive_turn
+
+
+def test_plugin_injected_turns_are_quiet_like_heartbeats():
+    assert quiet_proactive_turn(SimpleNamespace(_heartbeat_session_id="s1", metadata={}))
+    assert quiet_proactive_turn(SimpleNamespace(metadata={"hermes_plugin_injection": True, "hermes_plugin_id": "x"}))
+
+
+def test_user_messages_and_other_notices_are_unchanged():
+    assert not quiet_proactive_turn(SimpleNamespace(metadata={}))
+    assert not quiet_proactive_turn(SimpleNamespace(metadata=None))
+    assert not quiet_proactive_turn(SimpleNamespace(internal=True, metadata={"source": "background_process"}))
